# ==========================================
# Telegram Bot
# ==========================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ==========================================
# LLM Provider (openai | openrouter)
# ==========================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_key_here
# For OpenRouter you may leave empty, default will be used:
# LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_REQUEST_TIMEOUT=30
OPENROUTER_SITE_URL=https://your-domain.example
OPENROUTER_APP_NAME=ai-car-consultant-bot

# Backward compatibility (optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# ==========================================
# Embeddings / RAG
# ==========================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
VECTOR_DB_PATH=./chroma_db

# ==========================================
# Database / Redis
# ==========================================
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/car_bot
REDIS_URL=redis://redis:6379/0

# ==========================================
# App Settings
# ==========================================
# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenAI API
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/car_bot

# Redis
REDIS_URL=redis://localhost:6379/0

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=False

# Manager Notifications
MANAGER_CHAT_ID=-1001234567890
NOTIFICATION_PRIORITY_THRESHOLD=7

# RAG Settings
VECTOR_DB_PATH=./chroma_db
EMBEDDING_MODEL=text-embedding-3-small

# Cost Calculation
DEFAULT_COMPANY_COMMISSION=2500
DEFAULT_SHIPPING_BUFFER=1.1

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=20
MAX_TOKENS_PER_DAY=100000
